# One.com webb-/server mail (SMTP)
# Använd samma postlådelösen som i inkorgen eller ett app-/genererat lösen för "extern klient".

SMTP_HOST=send.one.com
SMTP_PORT=587
# Sätt till true för port 465 (SSL)
SMTP_SECURE=false

SMTP_USER=info@tradgardsform.se
SMTP_PASS=

# Till (mottagare) och avsändare vid behov — standard är info@tradgardsform.se
CONTACT_MAIL_TO=info@tradgardsform.se
CONTACT_MAIL_FROM=info@tradgardsform.se

# Google Ads — konvertering (valfritt). Hittar du i Google Ads under Konverteringar.
# Publikt prefix NEXT_PUBLIC_ så kundens webbläsare kan ladda taggen.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=dEtHEr_label_som_googLe_visar

# Canonical webbadress för sitemap/robots (https, utan snedstreck sist). Valfritt om du använder tradgardsform.se som default i koden.
# NEXT_PUBLIC_SITE_URL=https://tradgardsform.se
